with "config/adaflight_host_config.gpr";
with "adaflight_core.gpr";
project Adaflight_Host is
   for Source_Dirs use ("src/", "../stm32f4/src/", "gen/", "config/");
   for Object_Dir use "obj/" & Adaflight_Host_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("adaflight_host.adb");

   --  The board's hardware packages take their host bodies; the flight
   --  integration is the STM32F4 image's own.
   for Excluded_Source_Files use
     ("adaflight-stm32-adc.adb", "adaflight-stm32-exti.adb", "adaflight-stm32-flash.ads",
      "adaflight-stm32-flash.adb", "adaflight-stm32-gpio.adb", "adaflight-stm32-gyro.adb",
      "adaflight-stm32-mcu.adb", "adaflight-stm32-sound.adb", "adaflight-stm32-spi.adb",
      "adaflight-stm32-time.adb", "adaflight-stm32-usart.adb", "adaflight_stm32f4.adb");

   package Naming is
      for Body ("Adaflight.STM32.ADC") use "adaflight-host-adc.adb";
      for Body ("Adaflight.STM32.EXTI") use "adaflight-host-exti.adb";
      for Spec ("Adaflight.STM32.Flash") use "adaflight-host-flash.ads";
      for Body ("Adaflight.STM32.Flash") use "adaflight-host-flash.adb";
      for Body ("Adaflight.STM32.GPIO") use "adaflight-host-gpio.adb";
      for Body ("Adaflight.STM32.Gyro") use "adaflight-host-gyro.adb";
      for Body ("Adaflight.STM32.MCU") use "adaflight-host-mcu.adb";
      for Body ("Adaflight.STM32.Sound") use "adaflight-host-sound.adb";
      for Body ("Adaflight.STM32.SPI") use "adaflight-host-spi.adb";
      for Body ("Adaflight.STM32.Time") use "adaflight-host-time.adb";
      for Body ("Adaflight.STM32.USART") use "adaflight-host-usart.adb";
   end Naming;

   package Compiler is
      for Default_Switches ("Ada") use Adaflight_Host_Config.Ada_Compiler_Switches & ("-gnatyM120", "-gnata");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
end Adaflight_Host;
