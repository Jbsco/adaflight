with "config/adaflight_stm32f7_config.gpr";
with "gen/adaflight_feature_units.gpr";
project Adaflight_Stm32f7 is

   for Target use "arm-eabi";
   for Runtime ("Ada") use Project'Project_Dir & "runtime";

   for Source_Dirs use ("src/", "../stm32f4/src/", "gen/", "config/");
   --  The F4 crate's main and the units the F7 replaces: the platform's
   --  clocks and sections, and the drivers whose register sets differ.
   for Excluded_Source_Files use
     ("adaflight_stm32f4.adb", "adaflight-stm32-platform.ads", "adaflight-stm32-usart.adb",
      "adaflight-stm32-spi.adb", "adaflight-stm32-flash.adb", "adaflight-stm32-usb.adb",
      "adaflight-stm32-i2c.adb") & Adaflight_Feature_Units.Excluded;

   package Naming is
      for Spec ("Adaflight.STM32.Platform") use "adaflight-stm32-platform__stm32f7.ads";
      for Body ("Adaflight.STM32.USART") use "adaflight-stm32-usart__stm32f7.adb";
      for Body ("Adaflight.STM32.SPI") use "adaflight-stm32-spi__stm32f7.adb";
      for Body ("Adaflight.STM32.Flash") use "adaflight-stm32-flash__stm32f7.adb";
      for Body ("Adaflight.STM32.USB") use "adaflight-stm32-usb__stm32f7.adb";
      for Body ("Adaflight.STM32.I2C") use "adaflight-stm32-i2c__stm32f7.adb";
      for Body ("Adaflight.STM32.Menu") use Adaflight_Feature_Units.Menu_Body;
      for Body ("Adaflight.STM32.SD") use Adaflight_Feature_Units.SD_Body;
      for Body ("Adaflight.STM32.Compass") use Adaflight_Feature_Units.Compass_Body;
      for Body ("Adaflight.STM32.Baro") use Adaflight_Feature_Units.Baro_Body;
      for Body ("Adaflight.STM32.Pitot") use Adaflight_Feature_Units.Pitot_Body;
      for Body ("Adaflight.STM32.Optical_Flow") use Adaflight_Feature_Units.Optical_Flow_Body;
      for Body ("Adaflight.STM32.RX_SPI") use Adaflight_Feature_Units.RX_SPI_Body;
   end Naming;
   for Object_Dir use "obj/" & Adaflight_Stm32f7_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("adaflight_stm32f7.adb");

   package Compiler is
      for Local_Configuration_Pragmas use "gen/adaflight-checks.adc";
      case Adaflight_Stm32f7_Config.Build_Profile is
         when "release" =>
            for Default_Switches ("Ada") use Adaflight_Stm32f7_Config.Ada_Compiler_Switches & ("-gnatyM120");
            --  The unpacking runs before the packed data exists; see the core's decoder.
            for Switches ("adaflight-stm32-data_pack.adb") use
              Adaflight_Stm32f7_Config.Ada_Compiler_Switches & ("-gnatyM120", "-fno-lto");
            --  The build stamp changes with every build, so it stays out of the packed data.
            for Switches ("adaflight-stm32-build_stamp.adb") use
              Adaflight_Stm32f7_Config.Ada_Compiler_Switches & ("-gnatyM120", "-fno-lto");
         when others =>
            for Default_Switches ("Ada") use Adaflight_Stm32f7_Config.Ada_Compiler_Switches & ("-gnatyM120", "-gnata");
      end case;
   end Compiler;

   package Linker is
      for Switches ("Ada") use
        ("-flto", "-flto-partition=one", "-Os", "-ffunction-sections", "-fdata-sections", "-Wl,--gc-sections",
         "-Wl,--enable-non-contiguous-regions", "-Wl,--no-warn-rwx-segments",
         "-Wl,--defsym=__stack_size=32768",
         "-L" & Project'Project_Dir & "gen",
         "-T", Project'Project_Dir & "ld/adaflight-stm32f7.ld",
         "-Wl,-Map=" & Project'Project_Dir & "obj/adaflight_stm32f7.map");
   end Linker;

end Adaflight_Stm32f7;
