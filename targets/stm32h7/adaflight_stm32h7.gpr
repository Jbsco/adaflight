with "config/adaflight_stm32h7_config.gpr";
project Adaflight_Stm32h7 is

   for Target use "arm-eabi";
   for Runtime ("Ada") use Project'Project_Dir & "runtime";

   --  The first image needs only the board's pins from the F4 crate's sources.
   for Source_Dirs use ("src/", "../stm32f4/src/", "gen/", "config/");
   for Source_Files use ("adaflight_stm32h7.adb", "adaflight-pins.ads", "adaflight-board.ads");
   for Object_Dir use "obj/" & Adaflight_Stm32h7_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("adaflight_stm32h7.adb");

   package Compiler is
      for Local_Configuration_Pragmas use "gen/adaflight-checks.adc";
      for Default_Switches ("Ada") use Adaflight_Stm32h7_Config.Ada_Compiler_Switches & ("-gnatyM120");
   end Compiler;

   --  The STM32F7 crate's linker script: the memory layout and RAM sections it includes come from this
   --  crate's gen/ directory.
   package Linker is
      for Switches ("Ada") use
        ("-flto", "-Os", "-ffunction-sections", "-fdata-sections", "-Wl,--gc-sections",
         "-Wl,--enable-non-contiguous-regions", "-Wl,--no-warn-rwx-segments",
         "-L" & Project'Project_Dir & "gen",
         "-T", Project'Project_Dir & "../stm32f7/ld/adaflight-stm32f7.ld",
         "-Wl,-Map=" & Project'Project_Dir & "obj/adaflight_stm32h7.map");
   end Linker;

end Adaflight_Stm32h7;
