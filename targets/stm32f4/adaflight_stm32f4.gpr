with "config/adaflight_stm32f4_config.gpr";
project Adaflight_Stm32f4 is

   for Target use "arm-eabi";
   for Runtime ("Ada") use "light-tasking-stm32f4";

   for Source_Dirs use ("src/", "gen/", "config/");
   for Object_Dir use "obj/" & Adaflight_Stm32f4_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("adaflight_stm32f4.adb");

   package Compiler is
      for Local_Configuration_Pragmas use "gen/adaflight-checks.adc";
      case Adaflight_Stm32f4_Config.Build_Profile is
         when "release" =>
            for Default_Switches ("Ada") use Adaflight_Stm32f4_Config.Ada_Compiler_Switches & ("-gnatyM120");
         when others =>
            for Default_Switches ("Ada") use Adaflight_Stm32f4_Config.Ada_Compiler_Switches & ("-gnatyM120", "-gnata");
      end case;
   end Compiler;

   package Linker is
      for Switches ("Ada") use
        ("-flto", "-Os", "-ffunction-sections", "-fdata-sections", "-Wl,--gc-sections", "-Wl,--no-warn-rwx-segments",
         "-Wl,--defsym=__stack_size=32768",
         "-T", Project'Project_Dir & "ld/adaflight-stm32f4.ld",
         "-Wl,-Map=" & Project'Project_Dir & "obj/adaflight_stm32f4.map");
   end Linker;

end Adaflight_Stm32f4;
