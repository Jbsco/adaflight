with "config/adaflight_tests_config.gpr";
with "adaflight_core.gpr";
project Adaflight_Tests is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Adaflight_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("vector_check.adb");

   package Compiler is
      for Default_Switches ("Ada") use Adaflight_Tests_Config.Ada_Compiler_Switches &
        ("-gnatyM120");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Adaflight_Tests;
