with Adaflight.Settings_Table;
package body Adaflight.Blackbox_Info with SPARK_Mode is
   use type Interfaces.Unsigned_8;
   use type Interfaces.Unsigned_32;
   use type Interfaces.Integer_32;
   use type Interfaces.Integer_64;
   subtype Unsigned_8 is Interfaces.Unsigned_8;
   subtype Unsigned_16 is Interfaces.Unsigned_16;
   subtype Unsigned_32 is Interfaces.Unsigned_32;
   subtype Integer_8 is Interfaces.Integer_8;
   subtype Integer_16 is Interfaces.Integer_16;

   function U8 (X : Unsigned_8) return Integer_32 is (Integer_32 (X));
   function U16 (X : Unsigned_16) return Integer_32 is (Integer_32 (X));
   function I8 (X : Integer_8) return Integer_32 is (Integer_32 (X));
   function I16 (X : Integer_16) return Integer_32 is (Integer_32 (X));
   function B (X : Boolean) return Integer_32 is (if X then 1 else 0);
   --  A 32-bit word as the reference's signed print of it.
   function W (X : Unsigned_32) return Integer_32 is
     (if X >= 2 ** 31 then Integer_32 (Interfaces.Integer_64 (X) - 2 ** 32) else Integer_32 (X));

   --  The debug mode's name from the settings' table, UNKNOWN past it.
   function Debug_Name (Mode : Integer_32) return Header.Text is
      T : Header.Text;
   begin
      if Mode >= 0 and then Natural (Mode) < Adaflight.Settings_Table.Value_Count (Adaflight.Settings_Table.Table_Debug)
      then
         declare
            Name : constant String :=
              Adaflight.Settings_Table.Value_Name (Adaflight.Settings_Table.Table_Debug, Natural (Mode));
            K    : Natural := 0;
         begin
            T.Length := Natural'Min (Name'Length, Header.Text_Max);
            for J in Name'Range loop
               exit when K = T.Length;
               K := K + 1;
               T.Data (K) := Name (J);
               pragma Loop_Invariant (K <= T.Length);
            end loop;
         end;
      else
         T.Length := 7;
         T.Data (1 .. 7) := "UNKNOWN";
      end if;
      return T;
   end Debug_Name;

   --  The craft name's bytes before the first zero.
   function Craft_Name (C : Configuration) return Header.Text is
      T : Header.Text;
   begin
      for I in C.Pilot_Config.Craft_Name'Range loop
         exit when C.Pilot_Config.Craft_Name (I) = 0 or else T.Length = Header.Text_Max;
         T.Length := T.Length + 1;
         T.Data (T.Length) := Character'Val (C.Pilot_Config.Craft_Name (I));
      end loop;
      return T;
   end Craft_Name;

