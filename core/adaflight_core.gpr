with "config/adaflight_core_config.gpr";
project Adaflight_Core is

   for Library_Name use "adaflight_core";
   for Library_Version use Project'Library_Name & ".so." & Adaflight_Core_Config.Crate_Version;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Adaflight_Core_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("ADAFLIGHT_CORE_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   --  A build without debug values takes the debug build spec that turns them off, and a build without the
   --  flight plan the plan build spec that turns it off, and a build without servos, the LED strip, the GPS,
   --  the SD card, the flight log, the flash chip, the compass, the barometer, the rangefinders, the pitot sensor,
   --  the OLED dashboard or the race transponder the servo, LED, GPS, SD, flight log, flash, compass, barometer,
   --  rangefinder, pitot, dashboard or transponder build spec, and a build without the gimbal control or the
   --  software serial ports the gimbal or soft serial build spec.
   type Switch is ("on", "off");
   Debug_Values : Switch := external ("ADAFLIGHT_DEBUG_VALUES", "on");
   Flight_Plan  : Switch := external ("ADAFLIGHT_FLIGHT_PLAN", "on");
   Servos       : Switch := external ("ADAFLIGHT_SERVOS", "on");
   LED_Strip    : Switch := external ("ADAFLIGHT_LED_STRIP", "on");
   GPS          : Switch := external ("ADAFLIGHT_GPS", "on");
   SD_Card      : Switch := external ("ADAFLIGHT_SD_CARD", "on");
   Blackbox     : Switch := external ("ADAFLIGHT_BLACKBOX", "on");
   Flash_Chip   : Switch := external ("ADAFLIGHT_FLASH_CHIP", "on");
   Compass      : Switch := external ("ADAFLIGHT_COMPASS", "on");
   Barometer    : Switch := external ("ADAFLIGHT_BAROMETER", "on");
   Rangefinder  : Switch := external ("ADAFLIGHT_RANGEFINDER", "on");
   Pitot        : Switch := external ("ADAFLIGHT_PITOT", "on");
   Dashboard    : Switch := external ("ADAFLIGHT_DASHBOARD", "on");
   Transponder  : Switch := external ("ADAFLIGHT_TRANSPONDER", "on");
   Gimbal       : Switch := external ("ADAFLIGHT_GIMBAL", "on");
   Soft_Serial  : Switch := external ("ADAFLIGHT_SOFT_SERIAL", "on");
   IBus_Telemetry : Switch := external ("ADAFLIGHT_IBUS_TELEMETRY", "on");
   Excluded := ();
   case Debug_Values is
      when "on" =>
         Excluded := Excluded & ("adaflight-debug_build__off.ads");
      when "off" =>
         Excluded := Excluded & ("adaflight-debug_build.ads");
   end case;
   case Flight_Plan is
      when "on" =>
         Excluded := Excluded & ("adaflight-plan_build__off.ads");
      when "off" =>
         Excluded := Excluded & ("adaflight-plan_build.ads");
   end case;
   case Servos is
      when "on" =>
         Excluded := Excluded & ("adaflight-servo_build__off.ads");
      when "off" =>
         Excluded := Excluded & ("adaflight-servo_build.ads");
   end case;
   case LED_Strip is
      when "on" =>
         Excluded := Excluded & ("adaflight-led_build__off.ads");
      when "off" =>
         Excluded := Excluded & ("adaflight-led_build.ads");
   end case;
   case GPS is
      when "on" =>
         Excluded := Excluded & ("adaflight-gps_build__off.ads");
      when "off" =>
         Excluded := Excluded & ("adaflight-gps_build.ads");
   end case;
   case SD_Card is
      when "on" =>
         Excluded := Excluded & ("adaflight-sd_build__off.ads");
      when "off" =>
         Excluded := Excluded & ("adaflight-sd_build.ads");
   end case;
   case Blackbox is
      when "on" =>
         Excluded := Excluded & ("adaflight-blackbox_build__off.ads");
      when "off" =>
         Excluded := Excluded & ("adaflight-blackbox_build.ads");
   end case;
   case Flash_Chip is
      when "on" =>
         Excluded := Excluded & ("adaflight-flash_build__off.ads");
      when "off" =>
         Excluded := Excluded & ("adaflight-flash_build.ads");
   end case;
   case Compass is
      when "on" =>
         Excluded := Excluded & ("adaflight-compass_build__off.ads");
      when "off" =>
         Excluded := Excluded & ("adaflight-compass_build.ads");
   end case;
   case Barometer is
      when "on" =>
         Excluded := Excluded & ("adaflight-baro_build__off.ads");
      when "off" =>
         Excluded := Excluded & ("adaflight-baro_build.ads");
   end case;
   case Rangefinder is
      when "on" =>
         Excluded := Excluded & ("adaflight-rangefinder_build__off.ads");
      when "off" =>
         Excluded := Excluded & ("adaflight-rangefinder_build.ads");
   end case;
   case Pitot is
      when "on" =>
         Excluded := Excluded & ("adaflight-pitot_build__off.ads");
      when "off" =>
         Excluded := Excluded & ("adaflight-pitot_build.ads");
   end case;
   case Dashboard is
      when "on" =>
         Excluded := Excluded & ("adaflight-dashboard_build__off.ads");
      when "off" =>
         Excluded := Excluded & ("adaflight-dashboard_build.ads");
   end case;
   case Transponder is
      when "on" =>
         Excluded := Excluded & ("adaflight-transponder_build__off.ads");
      when "off" =>
         Excluded := Excluded & ("adaflight-transponder_build.ads");
   end case;
   case Gimbal is
      when "on" =>
         Excluded := Excluded & ("adaflight-gimbal_build__off.ads");
      when "off" =>
         Excluded := Excluded & ("adaflight-gimbal_build.ads");
   end case;
   case Soft_Serial is
      when "on" =>
         Excluded := Excluded & ("adaflight-soft_serial_build__off.ads");
      when "off" =>
         Excluded := Excluded & ("adaflight-soft_serial_build.ads");
   end case;
   case IBus_Telemetry is
      when "on" =>
         Excluded := Excluded & ("adaflight-ibus_telemetry_build__off.ads");
      when "off" =>
         Excluded := Excluded & ("adaflight-ibus_telemetry_build.ads");
   end case;
   for Excluded_Source_Files use Excluded;

   package Naming is
      case Debug_Values is
         when "on" =>
            null;
         when "off" =>
            for Spec ("Adaflight.Debug_Build") use "adaflight-debug_build__off.ads";
      end case;
      case Flight_Plan is
         when "on" =>
            null;
         when "off" =>
            for Spec ("Adaflight.Plan_Build") use "adaflight-plan_build__off.ads";
      end case;
      case Servos is
         when "on" =>
            null;
         when "off" =>
            for Spec ("Adaflight.Servo_Build") use "adaflight-servo_build__off.ads";
      end case;
      case LED_Strip is
         when "on" =>
            null;
         when "off" =>
            for Spec ("Adaflight.LED_Build") use "adaflight-led_build__off.ads";
      end case;
      case GPS is
         when "on" =>
            null;
         when "off" =>
            for Spec ("Adaflight.GPS_Build") use "adaflight-gps_build__off.ads";
      end case;
      case SD_Card is
         when "on" =>
            null;
         when "off" =>
            for Spec ("Adaflight.SD_Build") use "adaflight-sd_build__off.ads";
      end case;
      case Blackbox is
         when "on" =>
            null;
         when "off" =>
            for Spec ("Adaflight.Blackbox_Build") use "adaflight-blackbox_build__off.ads";
      end case;
      case Flash_Chip is
         when "on" =>
            null;
         when "off" =>
            for Spec ("Adaflight.Flash_Build") use "adaflight-flash_build__off.ads";
      end case;
      case Compass is
         when "on" =>
            null;
         when "off" =>
            for Spec ("Adaflight.Compass_Build") use "adaflight-compass_build__off.ads";
      end case;
      case Barometer is
         when "on" =>
            null;
         when "off" =>
            for Spec ("Adaflight.Baro_Build") use "adaflight-baro_build__off.ads";
      end case;
      case Rangefinder is
         when "on" =>
            null;
         when "off" =>
            for Spec ("Adaflight.Rangefinder_Build") use "adaflight-rangefinder_build__off.ads";
      end case;
      case Pitot is
         when "on" =>
            null;
         when "off" =>
            for Spec ("Adaflight.Pitot_Build") use "adaflight-pitot_build__off.ads";
      end case;
      case Dashboard is
         when "on" =>
            null;
         when "off" =>
            for Spec ("Adaflight.Dashboard_Build") use "adaflight-dashboard_build__off.ads";
      end case;
      case Transponder is
         when "on" =>
            null;
         when "off" =>
            for Spec ("Adaflight.Transponder_Build") use "adaflight-transponder_build__off.ads";
      end case;
      case Gimbal is
         when "on" =>
            null;
         when "off" =>
            for Spec ("Adaflight.Gimbal_Build") use "adaflight-gimbal_build__off.ads";
      end case;
      case Soft_Serial is
         when "on" =>
            null;
         when "off" =>
            for Spec ("Adaflight.Soft_Serial_Build") use "adaflight-soft_serial_build__off.ads";
      end case;
      case IBus_Telemetry is
         when "on" =>
            null;
         when "off" =>
            for Spec ("Adaflight.IBus_Telemetry_Build") use "adaflight-ibus_telemetry_build__off.ads";
      end case;
   end Naming;

   package Compiler is
      case Adaflight_Core_Config.Build_Profile is
         when "release" =>
            for Default_Switches ("Ada") use Adaflight_Core_Config.Ada_Compiler_Switches & ("-gnatyM120");
            --  The unpacking's decoder runs before the packed data exists, so it stays outside link time
            --  optimization: its constants keep its object file's name, which the packing leaves in flash.
            for Switches ("adaflight-lzma.adb") use
              Adaflight_Core_Config.Ada_Compiler_Switches & ("-gnatyM120", "-fno-lto");
            --  Dynamic notch builds for speed.
            for Switches ("adaflight-dyn_notch.adb") use
              Adaflight_Core_Config.Ada_Compiler_Switches & ("-gnatyM120", "-O2");
         when others =>
            for Default_Switches ("Ada") use Adaflight_Core_Config.Ada_Compiler_Switches & ("-gnatyM120", "-gnata");
      end case;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Prove is
      for Proof_Switches ("Ada") use
        ("--level=2",
         "--steps=200000",
         "--timeout=300",
         "--report=all",
         "--output-header",
         "--checks-as-errors=on",
         "--warnings=error");
   end Prove;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Adaflight_Core;
