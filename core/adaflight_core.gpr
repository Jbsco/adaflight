with "config/adaflight_core_config.gpr";
project Adaflight_Core is

   for Library_Name use "adaflight_core";
   for Library_Version use Project'Library_Name & ".so." & Adaflight_Core_Config.Crate_Version;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Adaflight_Core_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("ADAFLIGHT_CORE_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   --  A build without debug values takes the debug build spec that turns them off.
   type Switch is ("on", "off");
   Debug_Values : Switch := external ("ADAFLIGHT_DEBUG_VALUES", "on");
   case Debug_Values is
      when "on" =>
         for Excluded_Source_Files use ("adaflight-debug_build__off.ads");
      when "off" =>
         for Excluded_Source_Files use ("adaflight-debug_build.ads");
   end case;

   package Naming is
      case Debug_Values is
         when "on" =>
            null;
         when "off" =>
            for Spec ("Adaflight.Debug_Build") use "adaflight-debug_build__off.ads";
      end case;
   end Naming;

   package Compiler is
      case Adaflight_Core_Config.Build_Profile is
         when "release" =>
            for Default_Switches ("Ada") use Adaflight_Core_Config.Ada_Compiler_Switches & ("-gnatyM120");
            --  The unpacking's decoder runs before the packed data exists, so it stays outside link time
            --  optimization: its constants keep its object file's name, which the packing leaves in flash.
            for Switches ("adaflight-lzma.adb") use
              Adaflight_Core_Config.Ada_Compiler_Switches & ("-gnatyM120", "-fno-lto");
            --  Dynamic notch builds for speed.
            for Switches ("adaflight-dyn_notch.adb") use
              Adaflight_Core_Config.Ada_Compiler_Switches & ("-gnatyM120", "-O2");
         when others =>
            for Default_Switches ("Ada") use Adaflight_Core_Config.Ada_Compiler_Switches & ("-gnatyM120", "-gnata");
      end case;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Prove is
      for Proof_Switches ("Ada") use
        ("--level=2",
         "--steps=200000",
         "--timeout=300",
         "--report=all",
         "--output-header",
         "--checks-as-errors=on",
         "--warnings=error");
   end Prove;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Adaflight_Core;
