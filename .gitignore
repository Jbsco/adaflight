# Build outputs
**/obj/
**/lib/
**/bin/
*.o
*.ali
.redo/

# Alire workspace state is machine-specific; the lock pins the prover version used for proof results
**/alire/*
!**/alire/alire.lock
**/config/

# Prover transcripts
gnatprove-run.txt

# Editor noise
*.swp

# Generated board packages of the target crates
targets/*/gen/

# The host image's configuration store and OSD screen when run from its directory
targets/host/adaflight-eeprom.bin
targets/host/adaflight-osd.txt
targets/stm32f7/runtime/
