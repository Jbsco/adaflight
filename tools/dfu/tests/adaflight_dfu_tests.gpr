with "config/adaflight_dfu_tests_config.gpr";
project Adaflight_DFU_Tests is

   for Source_Dirs use ("src/", "../src/", "config/");
   for Excluded_Source_Files use ("adaflight_dfu.adb");
   for Object_Dir use "obj/" & Adaflight_DFU_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("dfu_check.adb");

   package Compiler is
      for Default_Switches ("Ada") use Adaflight_DFU_Tests_Config.Ada_Compiler_Switches & ("-gnatyM120", "-gnata");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Adaflight_DFU_Tests;
