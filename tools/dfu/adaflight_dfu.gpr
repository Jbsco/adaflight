with "config/adaflight_dfu_config.gpr";
project Adaflight_DFU is

   for Source_Dirs use ("src/", "src/usb/", "config/");
   for Object_Dir use "obj/" & Adaflight_DFU_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("adaflight_dfu.adb");

   package Compiler is
      for Default_Switches ("Ada") use Adaflight_DFU_Config.Ada_Compiler_Switches & ("-gnatyM120", "-gnata");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Prove is
      for Proof_Switches ("Ada") use
        ("--level=2",
         "--report=all",
         "--output-header",
         "--checks-as-errors=on",
         "--warnings=error");
   end Prove;

end Adaflight_DFU;
